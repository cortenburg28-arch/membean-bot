Cell[CellGroupData[{

Cell["Table 2: times through the intervals BMG", "Section",
 CellChangeTimes->{{3.513930038816259*^9, 
  3.513930048868091*^9}},ExpressionUUID->"24367814-c274-4ed1-8984-\
b00678c81087"],

Cell[BoxData[GridBox[{
   {
    RowBox[{"style", " ", "of", " ", "walking"}], 
    RowBox[{"zero", " ", "to", " ", "four", " ", "meters", " ", 
     RowBox[{"(", "s", ")"}]}], 
    RowBox[{"four", " ", "to", " ", "eight", " ", "meters", " ", 
     RowBox[{"(", "s", ")"}]}], 
    RowBox[{"eight", " ", "to", " ", "12", " ", "meters", " ", 
     RowBox[{"(", "s", ")"}]}], 
    RowBox[{"12", " ", "to", " ", "16", " ", "meters", " ", 
     RowBox[{"(", "s", ")"}]}], 
    RowBox[{"16", " ", "to", " ", "20", " ", "meters", " ", 
     RowBox[{"(", "s", ")"}]}]},
   {"walking", "3.72", "1.4", "1.54", "2.27", "1.94"},
   {"running", "2.29", "0.74", "0.47", "0.75", "0.79"},
   {
    RowBox[{"walk", " ", "backwards"}], "5.00", "1.82", "1.94", "2.11", "1.35"}
  },
  GridBoxDividers->{
   "Columns" -> {{True}}, "ColumnsIndexed" -> {}, "Rows" -> {{True}}, 
    "RowsIndexed" -> {}}]], "Input",
 CellChangeTimes->{{3.5139300597593184`*^9, 3.5139301786228037`*^9}, {
  3.842619214527054*^9, 
  3.8426192149618597`*^9}},ExpressionUUID->"bfe02520-b51f-46ae-8b63-\
c201ec657c05"],

Cell["\<\
With the exception of the first interval (see below) here is how you would \
find the time that the runner is in each interval.  Each clock was started at \
the same time and as the runner reached the clock that clock was stopped.  \
So, the time in the 8m spot is the time that the runner was in both the zero \
to four zone and the four to eight zone.  I need to subtract the total time \
(0 to 8m) from the preceding section (0 to 4m) and I will have the time that \
the runner was in the second zone (4m to 8m).  The process is repeated for \
each subsequent interval.\
\>", "Text",
 CellChangeTimes->{{3.513930553496956*^9, 3.513930709034857*^9}, {
  3.514019845223694*^9, 
  3.514019847000877*^9}},ExpressionUUID->"35850a8b-4e76-4138-8f27-\
d10737641f2d"],

Cell[BoxData[
 RowBox[{"time4to8m", "=", 
  RowBox[{"time0to8m", "-", "time0to4m"}]}]], "Input",
 CellChangeTimes->{{3.513930712220401*^9, 
  3.513930733507595*^9}},ExpressionUUID->"093dfa15-b90f-449d-90ec-\
85bd74671e40"],

Cell["in general this can be expanded in less specific notation", "Text",
 CellChangeTimes->{{3.5139307488577623`*^9, 
  3.513930758553381*^9}},ExpressionUUID->"5de9b78b-4195-42ba-9844-\
b0a9d57c5406"],

Cell[BoxData[
 RowBox[{"timeofinterval", "=", 
  RowBox[{"totaltime", "-", "timeofpreceedingintervals"}]}]], "Input",
 CellChangeTimes->{{3.513930760197173*^9, 
  3.513930772730455*^9}},ExpressionUUID->"c8f0609e-5a19-4658-8781-\
bd5203607856"],

Cell["\<\
for walking we would have (taking the first row from Table 1):\
\>", "Text",
