Notebook[{
Cell["\<\
All of the purple are comments from the instructor to student (read ME to \
YOU).  They should not appear in your lab writing.
v.25.22.23\
\>", "Subsubtitle",
 CellChangeTimes->{{3.513843085304088*^9, 3.5138431068085327`*^9}, {
  3.523986113720333*^9, 3.523986121254328*^9}, {3.745072879662668*^9, 
  3.745072888949439*^9}, {3.842618451825842*^9, 3.842618453536936*^9}, {
  3.8715004203073263`*^9, 
  3.871500429216955*^9}},ExpressionUUID->"e39a3e99-5078-4602-8865-\
95152f910f36"],

Cell[CellGroupData[{

Cell["Exploring various walking styles", "Title",
 CellChangeTimes->{
  3.513842531726706*^9},ExpressionUUID->"7205d498-1ae8-49aa-a182-\
bb17963ba29c"],

Cell["How to walk like an Egyptian", "Subtitle",
 CellChangeTimes->{
  3.5138425408407497`*^9},ExpressionUUID->"de3f514b-3560-42e8-97d6-\
ddfd160c01df"],

Cell[TextData[{
 "Brian Geyer\nPartner: Sparky Pomfret\n\nDates: 1/27/2009 to 1/30/2009, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", "/", "2"}], "/", 
    SuperscriptBox["2009", "1"]}], TraditionalForm]],ExpressionUUID->
  "45df2e2d-e3f8-488f-907f-7cf8b3f8497f"]
}], "Subsubtitle",
 CellChangeTimes->{{3.5138425575264597`*^9, 3.5138425667268343`*^9}, {
   3.513842921194133*^9, 3.5138429226558037`*^9}, 3.715515839450029*^9, {
   3.871500442712977*^9, 
   3.871500446459803*^9}},ExpressionUUID->"cadae260-4bfe-4e42-b603-\
95a08830e565"],

Cell["\<\
1: Note how consecutive dates are done.  Only the dates that data was \
collected in the lab should be listed.\
\>", "Text",
 CellChangeTimes->{{3.513842928492455*^9, 3.51384295372117*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"0b687943-6f24-4882-9025-84f310323d22"],

Cell[TextData[{
 "Working in the gym we collected time and distance data that allowed us to \
compute our average speed for various walking styles.  My partner and I used \
a 30 ",
 Cell[BoxData[
  FormBox["meter", TraditionalForm]],ExpressionUUID->
  "9d2dcf21-2855-404b-b03e-2d54e2095387"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", "m", ")"}], "2"], TraditionalForm]],ExpressionUUID->
  "f79141c6-f157-4e05-9f24-c02be91776bf"],
 " tape and a stopwatch to collect our data.  We found that I was able to \
walk forward or backwards at roughly the same speed (2.19 meters/second (m/s) \
for forward and 2.15 m/s ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["", "3"], TraditionalForm]],ExpressionUUID->
  "c5e29219-bfac-4a0d-949c-e4e3b967e7fd"],
 " for backward) while I was much faster going forwards (5.91 m/s).  There is \
no standard value for how one walks but my ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["results", "4"], TraditionalForm]],ExpressionUUID->
  "5a787ced-bdee-440b-899c-d449fb11d216"],
 " (as you can see in the table later in the lab) compare favorably with \
others in the class."
}], "Text",
 CellChangeTimes->{
  3.513842578694401*^9, {3.5138429830184402`*^9, 
   3.5138430638011627`*^9}},ExpressionUUID->"bd600167-72a4-4d13-b782-\
d4918fcee303"],

Cell["\<\
2: The first time a unit is used it needs to be written out.
3. The next time only the abbreviation is needed
4: Even in a lab with no expected result I can make a claim about my data \
(here I state that I\[CloseCurlyQuote]m equally fast forward and backwards \
and much faster running).
NB: An abstract is no more than 4 sentences:
One sentence about what you did. 
One sentence about how you did it. (could be 2)
One sentence about what you got. Including numeric results and marks of \
quality if they exist.\
\>", "Text",
 CellChangeTimes->{{3.513842988130315*^9, 3.513842998098057*^9}, {
  3.51384304205834*^9, 3.513843074355537*^9}, {3.842618465480678*^9, 
  3.8426185106635227`*^9}, {3.871500515834448*^9, 3.871500541526071*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"5dfb651f-769c-4531-957f-93cc14edd5cc"],

Cell[CellGroupData[{

Cell["Table 1: times recorded at each interval BMG", "Section",
 CellChangeTimes->{
  3.513842649352749*^9},ExpressionUUID->"2e4e8f6d-f2a7-4f53-8b98-\
c5f83f219479"],

Cell[BoxData[GridBox[{
   {
    RowBox[{"Style", " ", "of", " ", "walking"}], 
    RowBox[{"four", " ", "meters", " ", 
     RowBox[{"(", "s", ")"}]}], 
    RowBox[{"eight", " ", "meters", " ", 
     RowBox[{"(", "s", ")"}]}], 
    RowBox[{"12", " ", "meters", " ", 
     RowBox[{"(", "s", ")"}]}], 
    RowBox[{"16", " ", "meters", " ", 
     RowBox[{"(", "s", ")"}]}], 
    RowBox[{"20", " ", "meters", " ", 
     RowBox[{"(", "s", ")"}]}]},
   {"walking", 
    SuperscriptBox["3.72", 
     StyleBox["1",
      FontColor->RGBColor[0.5, 0, 0.5]]], "5.12", "6.66", "8.93", "10.87"},
   {"running", "2.29", "3.03", "3.50", "4.25", "5.04"},
   {
    RowBox[{"walk", " ", "backwards"}], "5.00", "6.82", "8.76", "10.87", 
    "12.22"}
  },
  GridBoxDividers->{
   "Columns" -> {{True}}, "ColumnsIndexed" -> {}, "Rows" -> {{True}}, 
    "RowsIndexed" -> {}}]], "Text",
 CellChangeTimes->{{3.513842704549758*^9, 3.513842825487959*^9}, {
   3.513842896813898*^9, 3.513842903101791*^9}, 3.513843211226748*^9, 
