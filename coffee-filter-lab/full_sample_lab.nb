   3.842619230007903*^9},ExpressionUUID->"fe9f7b0e-9495-441c-9c47-\
8cc0bd09be2d"],

Cell[TextData[StyleBox["1: These are times written down from the stopwatch, \
not measurements.  Therefore the terminal digit does not need to be 0, 1, 5, \
or 9.",
 FontWeight->"Regular",
 FontColor->RGBColor[0.41817349507896545`, 0., 0.4242923628595407]]], "Text",
 CellChangeTimes->{{3.842618561147539*^9, 
  3.8426186179754257`*^9}},ExpressionUUID->"f7733792-3a1b-4622-aea7-\
a500be8ccd5e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"walking", "=", 
   RowBox[{"{", 
    RowBox[{
    "3.72`", ",", "5.12`", ",", "6.66`", ",", "8.93`", ",", "10.87`"}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"running", "=", 
   RowBox[{"{", 
    RowBox[{"2.29`", ",", "3.03`", ",", "3.5`", ",", "4.25`", ",", "5.04`"}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"backwards", "=", 
   RowBox[{"{", 
    RowBox[{"5", ",", "6.82`", ",", "8.76`", ",", "10.87`", ",", "12.22`"}], 
    "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.5138431585808077`*^9, 3.5138432016316833`*^9}},
 CellLabel->
  "In[110]:=",ExpressionUUID->"e66f8e27-459d-417c-8065-d63379b8f34f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"modelwalk", "=", 
   RowBox[{"LinearModelFit", "[", 
    RowBox[{"walking", ",", "x", ",", "x"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"modelrun", "=", 
   RowBox[{"LinearModelFit", "[", 
    RowBox[{"running", ",", "x", ",", "x"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"modelback", "=", 
   RowBox[{"LinearModelFit", "[", 
    RowBox[{"backwards", ",", "x", ",", "x"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.513843389954769*^9, 3.5138434447036037`*^9}},
 CellLabel->
  "In[113]:=",ExpressionUUID->"ade8bde7-080b-4bee-ae95-a353686b0faf"],

