Cell["\<\
My residual graph shows no pattern and my values are all less that \
\[PlusMinus]0.5.  These are both positive indicators.\
\>", "Text",
 CellChangeTimes->{{3.842619069112233*^9, 
  3.842619100013105*^9}},ExpressionUUID->"948c9360-4c7d-448f-b215-\
683a51ae984c"],

Cell[TextData[StyleBox["Note that the residual graph does not have gridlines.\
\nAlso note that both marks of quality have a statement after them and there \
is a general summary in the conculsion.",
 FontColor->RGBColor[0.41817349507896545`, 0., 0.4242923628595407]]], "Text",
 CellChangeTimes->{{3.84261882003343*^9, 3.842618831147213*^9}, {
  3.842619113547217*^9, 
  3.842619135045973*^9}},ExpressionUUID->"36fffedc-8dde-4d65-afe8-\
887cc45669b1"]
}, Open  ]],

