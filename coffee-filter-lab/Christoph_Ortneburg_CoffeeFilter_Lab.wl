    "R^2" -> Round[fitResults[#]["R2"], 0.000001],
    "n" -> fitResults[#]["nPoints"]
  ] & /@ trialNames
];

plotFits = Show[
  ListPlot[
    fitResults[#]["segment"] & /@ trialNames,
    PlotStyle -> trialColors,
    AxesLabel -> {"t (s)", "y (m)"},
    PlotLabel -> "Terminal region with linear fits",
    ImageSize -> Large,
    PlotLegends -> {"Trial 1", "Trial 2", "Trial 3", "Trial 4"}
  ],
  Plot[
    Evaluate[fitResults[#]["model"][t] & /@ trialNames],
    {t, tTermMin, tTermMax},
    PlotStyle -> ({Thick, #} & /@ trialColors)
  ]
];
Print[plotFits];

Print["=== 3) Values for the final data sheet ==="];
vtList = fitResults[#]["vt"] & /@ trialNames;
vtMean = Mean[vtList];
(* Group A style: largest |vt-mean|/mean as a fraction (e.g. 0.0231) *)
pctDiffFraction = Max[Abs[vtList - vtMean]/vtMean];
pctDiffPercent = 100.*pctDiffFraction;

finalDataRow = <|
  "# of filters" -> nFilters,
  "Mass, (g)" -> massGrams,
  "Terminal Velocity, (m/s)" -> Round[vtMean, 0.0001],
  "your name" -> "Christoph Ortneburg",
  "your % difference (Vt) (%)" -> Round[pctDiffFraction, 0.0001]
|>;

Print @ Grid[{
  {"Name", "Christoph Ortneburg"},
  {"# of filters", nFilters},
  {"Mass (g)", massGrams},
  {"Trial vt (m/s)", Round[vtList, 0.0001]},
  {"Mean vt (m/s)  →  enter in column C", Round[vtMean, 0.0001]},
  {"% diff fraction  →  enter in column E", Round[pctDiffFraction, 0.0001]},
  {"% diff in percent", Round[pctDiffPercent, 0.01]}
}, Frame -> All, Background -> {None, {RGBColor[0.85, 0.95, 0.85], None}}];

Print[finalDataRow];

Print["=== 4) Class group A comparison (optional) ==="];
classRows = {
  <|"filters" -> 2, "mass" -> 2.351, "vt" -> 2.1146, "name" -> "James Lake"|>,
  <|"filters" -> 3, "mass" -> 3.49, "vt" -> 2.43525, "name" -> "Abdul Hakim"|>,
  <|"filters" -> 4, "mass" -> massGrams, "vt" -> vtMean, "name" -> "Christoph Ortneburg"|>,
  <|"filters" -> 5, "mass" -> 5.3, "vt" -> 2.41521, "name" -> "James Tian"|>
};

plotClass = ListPlot[
  {#mass, #vt} & /@ classRows,
  AxesLabel -> {"mass (g)", "vt (m/s)"},
  PlotLabel -> "Class group A: mass vs terminal velocity",
  PlotStyle -> PointSize[0.03],
  ImageSize -> Large,
  Epilog -> {
    Text["Christoph (4 filters)", {massGrams, vtMean}, {-1.1, -1.5}],
    RGBColor[0.22, 0.45, 0.15], PointSize[0.04],
    Point[{massGrams, vtMean}]
  }
];
Print[plotClass];

plotLog = ListPlot[
  {Log10[#mass], Log10[#vt]} & /@ classRows,
  AxesLabel -> {"log10(m)", "log10(vt)"},
  PlotLabel -> "log-log: mass vs vt (class group A)",
  PlotStyle -> PointSize[0.03],
  ImageSize -> Large
];
Print[plotLog];

Print["=== Done ==="];
Print["Use finalDataRow for the spreadsheet. Excel AA313 etc. were empty (#DIV/0!); this file fills those results."];
