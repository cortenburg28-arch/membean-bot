];
Print[plotAll];

Print["=== 2) Linear fits in terminal region ==="];
fitResults = Association@Map[
  Function[name,
    Module[{seg, model, vt, b, r2},
      seg = selectTerminal[rawTrials[name]];
      model = LinearModelFit[seg, t, t];
      {b, vt} = model["BestFitParameters"];
      r2 = model["RSquared"];
      name -> <|
        "vt" -> vt,
        "intercept" -> b,
        "R2" -> r2,
        "nPoints" -> Length[seg],
        "model" -> model,
        "segment" -> seg
      |>
    ]
  ],
  trialNames
];

Print @ Dataset[
