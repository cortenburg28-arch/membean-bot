     RowBox[{"model4", "[", "\"\<FitResiduals\>\"", "]"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "\[Rule]", "\"\<Residuals from each model CO\>\""}], 
   ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
