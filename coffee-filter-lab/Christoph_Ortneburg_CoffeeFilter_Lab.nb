      RowBox[{"5.3", ",", "2.41521"}], "}"}]}], "}"}]}], ";"}]], "Input"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{"classRows", ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
