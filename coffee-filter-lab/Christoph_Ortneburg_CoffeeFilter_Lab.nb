     RowBox[{"\"\<data point\>\"", ",", "\"\<Difference from model\>\""}], 
     "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"Filling", "\[Rule]", "Axis"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"PointLegend", "[", 
     RowBox[{"Automatic", ",", 
      RowBox[{"{", 
       RowBox[{
       "\"\<model1\>\"", ",", "\"\<model2\>\"", ",", "\"\<model3\>\"", ",", 
        "\"\<model4\>\""}], "}"}], ",", 
      RowBox[{"LegendFunction", "\[Rule]", "\"\<Frame\>\""}]}], "]"}]}]}], 
  "]"}]], "Input"],

Cell["\<\
My residual graph shows no strong pattern and my residual values are small \
(all less than \[PlusMinus]0.1 m on the terminal-region fits).  These are \
both positive indicators.\
\>", "Text"]

}, Open]],

Cell[CellGroupData[{

