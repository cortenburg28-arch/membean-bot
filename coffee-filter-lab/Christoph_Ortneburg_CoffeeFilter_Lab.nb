   SuperscriptBox["R", "2"], TraditionalForm]]],
 " values \[OpenCurlyDoubleQuote]acceptable.\[CloseCurlyDoubleQuote]"
}], "Text"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"model1", "[", "\"\<FitResiduals\>\"", "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"model2", "[", "\"\<FitResiduals\>\"", "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"model3", "[", "\"\<FitResiduals\>\"", "]"}], ",", 
